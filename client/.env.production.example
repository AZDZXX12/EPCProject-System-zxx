# EPC项目管理系统 - 生产环境配置示例
# 复制为 .env.production 使用

# API配置（留空使用同源）
REACT_APP_API_URL=

# 构建优化
GENERATE_SOURCEMAP=false
INLINE_RUNTIME_CHUNK=false

# 应用信息
REACT_APP_NAME=EPC项目管理系统
REACT_APP_VERSION=2.1.0
NODE_ENV=production

# 功能开关
REACT_APP_USE_MOCK=false
REACT_APP_DEBUG=false
REACT_APP_ENABLE_MONITORING=true
